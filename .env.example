# Discord bot token from the Developer Portal (Bot -> Token)
DISCORD_TOKEN=

# Your application (client) ID from the Developer Portal (General Information)
CLIENT_ID=

# Optional: a guild (server) ID. When set, slash commands register instantly
# to that server. Leave empty to register commands globally (can take up to 1h).
GUILD_ID=

# Google Sheet for logging approved medal requests (defaults to the configured sheet).
SHEET_ID=
SHEET_GID=0

# Full service account JSON key contents (single line). Required for sheet logging.
# The service account's client_email must have Editor access to the sheet.
GOOGLE_SERVICE_ACCOUNT_JSON=
